# From Postgres.
FROM coldis/infrastructure-transactional-repository:5.0.11

# Copies the init script and the health check. The trailing slash keeps more than one source
# valid on every builder.
COPY script/*.sh /opt/psql-script/
# Owned by root and only executable by anyone else, as in the upgrade image: root runs these
# scripts (the entrypoint at every start, the health check every few minutes), and a database
# superuser can already run code as the postgres user, so scripts that account could rewrite are
# scripts it could have root run. Nothing writes into this folder at run time.
RUN chown -R root:root /opt/psql-script && \
	chmod -R 0755 /opt/psql-script
	
# Port.
ENV COPY_PORT=5432
	
ENTRYPOINT [ "./psql_replica_init.sh" ]
CMD [ "gosu", "postgres" , "postgres" ]


