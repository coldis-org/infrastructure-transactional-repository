# From the repository image of the same release as the primary. Both have to be on the same
# Debian, and so the same glibc: a physical replica copies index blocks, so a replica whose
# collation orders text differently from its primary reads those indexes wrong. Every published
# 7.0.0 to 7.0.3 is trixie; 7.1.0 is the first bookworm build, so a replica on it belongs to a
# primary on it and not to one still running an earlier 7.0.x.
FROM coldis/infrastructure-transactional-repository:7.1.0

# Copies init script.
COPY script/*.sh /opt/psql-script
RUN chown -R postgres:postgres /opt/psql-script && \
	chmod -R +x /opt/psql-script
	
# Port.
ENV COPY_PORT=5432
	
ENTRYPOINT [ "./psql_replica_init.sh" ]
CMD [ "gosu", "postgres" , "postgres" ]


