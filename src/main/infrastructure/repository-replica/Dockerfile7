# From the repository image of the same release as the primary. Both have to be on the same
# Debian, and so the same glibc: a physical replica copies index blocks, so a replica whose
# collation orders text differently from its primary reads those indexes wrong. Every published
# 7.0.0 to 7.0.3 is trixie; 7.1.0 is the first bookworm build, so a replica on it belongs to a
# primary on it and not to one still running an earlier 7.0.x.
#
# 7.2.0 is PostgreSQL 18.7, which fixes snapshot import on a standby: a parallel pg_dump run
# against a replica could corrupt the dump and the replica's own data, and only the standby's
# binary carries the fix. A minor update goes to the replica before its primary, since a newer
# minor reads an older one's WAL more reliably than the reverse.
#
# 7.4.0 is the same PostgreSQL 18.7 and bookworm as 7.2.0, so a 7.4.0 replica can follow a 7.2.0
# to 7.4.0 primary. It brings the memory budget (a replica too small for its primary's floors
# starts with a WARN instead of stopping), OOM targeting of child processes and the memory guard
# (dry-run by default).
FROM coldis/infrastructure-transactional-repository:7.4.0

# Copies the init script and the health check. The trailing slash keeps more than one source
# valid on every builder.
COPY script/*.sh /opt/psql-script/
# Owned by root and only executable by anyone else, as in the upgrade image: root runs these
# scripts (the entrypoint at every start, the health check every few minutes), and a database
# superuser can already run code as the postgres user, so scripts that account could rewrite are
# scripts it could have root run. Nothing writes into this folder at run time.
RUN chown -R root:root /opt/psql-script && \
	chmod -R 0755 /opt/psql-script
	
# Port.
ENV COPY_PORT=5432
	
ENTRYPOINT [ "./psql_replica_init.sh" ]
CMD [ "gosu", "postgres" , "postgres" ]


