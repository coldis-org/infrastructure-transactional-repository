# do not exist in this version - wal_decode_buffer_size

# From Debian.
FROM coldis/infrastructure-os:1.1.0 as debian

# From Postgres.
FROM postgres:14.23-bookworm

# Sets locale and UTF-8 charset.
ENV TZ=America/Sao_Paulo \
	LANG_NAME=pt_BR \
	LANG_FILE=pt_BR.UTF-8 \
	LANG=pt_BR.utf8 \
	LANGUAGE=pt_BR:pt
RUN localedef -i ${LANG_NAME} -c -f UTF-8 -A /usr/share/locale/locale.alias ${LANG_FILE} && \
	cp /usr/share/zoneinfo/${TZ} /etc/localtime

# Installs Postgres contrib, LDAP tools and cron.
RUN apt-get update && \
	apt-get install -y --no-install-recommends \
		postgresql-contrib-${PG_MAJOR} ldap-utils gettext cron && \
	apt-get clean -y && \
	rm -rf /var/lib/apt/lists/*

COPY cron /etc/cron.d
RUN chmod -R 0644 /etc/cron.d/ \
	&& crontab /etc/cron.d/cron_job

# Copies the server configuration.
COPY conf /tmp
RUN chown -R postgres:postgres /tmp

# Copies init script.
COPY --from=debian /opt/os-script /opt/os-script
COPY --from=debian /usr/bin/os* /usr/bin
RUN mkdir -p /opt/psql-script	
COPY script/psql /opt/psql-script
WORKDIR /opt/psql-script
RUN chown -R postgres:postgres /opt/psql-script && \
	chmod -R +x /opt/psql-script
	
# The memory guard and OOM targeting (MEMORY_GUARD_ENABLED, OOM_TARGETING_ENABLED) are off on this
# major: they are simulated and enabled on PostgreSQL 18 (Dockerfile7) only. They can be turned on
# here, untested. The tuner settings below apply to every major, WORK_MEM_ACTIVE_PERC=65 included:
# work_mem is sized for 65% of the connections at once, an over-commit that no guard covers here
# (100 sizes it for all of them, as before 7.4.0).
ENV POSTGRES_ADMIN_USER=postgres\
    POSTGRES_ADMIN_PASSWORD=postgres\
	MAX_CONNECTIONS=300\
	MAX_WAL_SENDERS_CONN_PERC=5\
	CPU_WORK_PERC=300\
	MAX_WORKER_PROCESSES=\
	MAX_WORKER_PROCESSES_PERC=170\
	MAX_PARALLEL_WORKERS_PERC=100\
	MAX_PARALLEL_MAINTENANCE_WORKERS_PERC=40\
	AUTOVACUUM_MAX_WORKERS_PERC=20\
	MAX_PARALLEL_WORKERS_PER_GATHER_PERC=20\
	MIN_RESERVED_MEMORY_PERC=15\
	MIN_RESERVED_MEMORY=262144\
	WAL_BUFFERS_PERC=3\
	WAL_BUFFERS_MAX=16384\
	WAL_WRITER_FLUSH_AFTER_PERC=3\
	WAL_WRITER_FLUSH_AFTER_MAX=131072\
	WAL_DECODE_BUFFER_SIZE_PERC=3\
	WAL_DECODE_BUFFER_SIZE_MAX=131072\
	TOTAL_LOGICAL_DECODING_WORK_MEM_PERC=10\
	LOGICAL_DECODING_WORK_MEM_MAX=262144\
	MIN_WAL_SIZE_DISC_PERC=1\
	MIN_WAL_SIZE_MAX=32768\
	MAX_WAL_SIZE_DISC_PERC=1\
	MAX_WAL_SIZE_MAX=32768\
	MAX_SLOT_WAL_KEEP_SIZE_MAX=512000\
	WAL_KEEP_SIZE_DISC_PERC=2\
	MAX_SLOT_WAL_KEEP_SIZE_DISC_PERC=10\
	SHARED_BUFFERS_PERC=25\
	EFFECTIVE_CACHE_SIZE_PERC=60\
	TOTAL_WORK_MEM_PERC=30\
	TOTAL_MAINTENANCE_WORK_MEM_PERC=20\
	MAINTENANCE_WORK_MEM_MAX=2097152\
	MAINTENANCE_WORK_MEM_SESSIONS=2\
	MIN_DYNAMIC_SHARED_MEMORY_PERC=2\
	TOTAL_LOCKS_MEMORY_PERC=10\
	MAX_LOCKS_PER_TRANSACTION_MAX=16384\
	MAX_LOCKS_PER_TRANSACTION_MIN=64\
	CONNECTION_MEMORY=16384\
	CONNECTIONS_MEMORY_MAX_PERC=35\
	CONNECTION_SHARED_BUFFERS_MAPPED_PERC=35\
	WORK_MEM_OPERATIONS=2\
	HUGE_PAGES=try\
	WORK_MEM_ACTIVE_PERC=65\
	WORK_MEM_MAX=\
	MAX_PARALLEL_WORKERS_PER_GATHER_MAX=2\
	SERVER_PROCESSES_MEMORY_MAX_PERC=10\
	IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30min\
	OOM_TARGETING_ENABLED=false\
	OOM_CHILD_SCORE_ADJ=100\
	MEMORY_GUARD_ENABLED=false\
	MEMORY_GUARD_MODE=dry-run\
	MEMORY_GUARD_INTERVAL=2\
	MEMORY_GUARD_FAST_INTERVAL=0.5\
	MEMORY_GUARD_MAX_INTERVAL=5\
	MEMORY_GUARD_TICK_BUDGET_MS=200\
	MEMORY_GUARD_IDLE_PERC=85\
	MEMORY_GUARD_ACTIVE_PERC=92\
	MEMORY_GUARD_CRITICAL_PERC=96\
	MEMORY_GUARD_IDLE_BATCH=5\
	MEMORY_GUARD_IDLE_MAX_PER_MIN=120\
	MEMORY_GUARD_CRITICAL_BATCH=10\
	MEMORY_GUARD_CANCEL_GRACE=1\
	MEMORY_GUARD_EXCLUDE_USERS=\
	MEMORY_GUARD_QUERY_CHARS=120\
	MEMORY_GUARD_STATUS_INTERVAL=300\
	MEMORY_GUARD_PAUSE_FILE=/tmp/memory_guard.pause\
	OVERWRITE_TUNED_ARGS=true
	
# Command.
ENTRYPOINT [ "./psql_init.sh" ]
CMD [ "docker-entrypoint.sh", "postgres" ]
